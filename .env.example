# URL publica y canonica del sitio, sin barra final. Obligatoria en produccion.
NEXT_PUBLIC_SITE_URL=https://www.ejemplo.cl

# Destino del formulario de contacto (webhook HTTPS: CRM, n8n, Make, Zapier, funcion propia).
# Solo servidor. Sin esta variable, el formulario responde "no disponible" en produccion.
CONTACT_WEBHOOK_URL=

# "true" solo cuando el contenido sea real y el sitio deba indexarse. Por defecto: noindex.
NEXT_PUBLIC_INDEXING_ENABLED=false
